# 1. Create a free proxy key at https://tokenguard-fawn.vercel.app
#    Add your own OpenAI or Anthropic credential there first, then create a
#    proxy key with a monthly budget. Your provider key never leaves TokenGuard.
TOKEN_GUARD_API_KEY=tg_live_your_key_here

# 2. TokenGuard edge proxy base URL
TOKEN_GUARD_BASE_URL=https://proxy.spendcap.dev/v1

# 3. Default model.
#    TokenGuard forwards to whichever provider your credential belongs to, so
#    this must be a model that provider serves:
#      Anthropic credential -> claude-haiku-4-5, claude-sonnet-4-5
#      OpenAI credential    -> gpt-4o-mini, gpt-4o
TOKEN_GUARD_MODEL=claude-haiku-4-5
